PORT=4000

# Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Evento
# En producción: URL de Vercel, sin barra final. Varias URLs separadas por coma.
CORS_ORIGIN=http://localhost:3000
API_KEY=
EVENT_NAME=UMG 2026
EVENT_DATE=2026-10-24
EVENT_LOCATION=SALON CAMPO DE LA FERIA, SAN FELIPE, RETALHULEU
EVENT_UNIVERSITY=Universidad Mariano Galvez

# Si CORS_ORIGIN incluye un *.vercel.app, los previews de Vercel también se aceptan.
# CORS_ALLOW_VERCEL_PREVIEWS=true

# ── Correo (elige UNA opción) ──────────────────────────────

# Opción A: Resend (recomendado) → https://resend.com
# En producción usa un dominio verificado; onboarding@resend.dev solo llega a tu cuenta.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=UMG 2026 <noreply@tu-dominio.com>

# Opción B: SMTP (Gmail, Outlook, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASS=contraseña-de-aplicacion
# EMAIL_FROM=UMG 2026 <tu-correo@gmail.com>
